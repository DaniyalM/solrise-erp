# =============================================================================
# Solrise ERP - environment configuration
#
#   cp .env.example .env   &&   edit .env
#
# Read by: compose/compose.local.yaml, compose/compose.prod.yaml and scripts/*.sh
#
# PORTABILITY: nothing here is host-specific. The same file is valid on
# CachyOS rootless Podman and on any Ubuntu VPS (Hostinger, Hetzner, DO...).
# Only DOMAIN, LETSENCRYPT_EMAIL and the passwords change per environment.
# =============================================================================

# --- 1. Project identity -----------------------------------------------------
PROJECT_NAME=solrise
COMPOSE_PROJECT_NAME=solrise

# --- 2. Container engine -----------------------------------------------------
# podman | docker. Scripts default to podman if unset.
CONTAINER_ENGINE=podman
# Compose binary: podman-compose locally, "docker compose" on a Docker VPS.
COMPOSE_CMD=podman-compose
# Where scripts clone frappe_docker (vendored, git-ignored).
FRAPPE_DOCKER_DIR=./frappe_docker
# Docker/Podman API socket for the Traefik provider.
#   Docker:  /var/run/docker.sock
#   rootless Podman: ${XDG_RUNTIME_DIR}/podman/podman.sock
DOCKER_SOCK=/var/run/docker.sock

# --- 3. Image & Frappe branch ------------------------------------------------
# CUSTOM_IMAGE/CUSTOM_TAG are what scripts/build-image.sh produces.
# Do NOT point this at the upstream frappe/erpnext tag in production: the
# custom image is what bakes erpnext + hrms so they survive container recreation.
CUSTOM_IMAGE=solrise/erpnext
CUSTOM_TAG=version-15
PULL_POLICY=missing

FRAPPE_PATH=https://github.com/frappe/frappe
# Selects BOTH the frappe/base + frappe/build base images and the checked-out
# branch, so the toolchain always matches the framework. Keep it in step with
# the branches in APPS_JSON below.
FRAPPE_BRANCH=version-15
# Must be fully qualified for rootless Podman (it will not resolve short names).
FRAPPE_IMAGE_PREFIX=docker.io/frappe

# --- 4. Apps baked into the image -------------------------------------------
# The app list lives in apps.json (a real file) - NOT inline in this .env.
# Shell-sourced .env values must not contain unquoted spaces or JSON, because
# brace expansion and word splitting corrupt them silently.
APPS_JSON_FILE=apps.json

# apps.json references these, so one apps.json works on any host. Set
# SOLRISE_APP_URL to your real git remote for production. If you do not have the
# custom app repository yet, DELETE its entry from apps.json.
#   production : https://github.com/<your-org>/solrise_erp
#   local only : git://host.containers.internal:9418/solrise_erp
#                (serve with: git daemon --base-path=... --export-all)
SOLRISE_APP_URL=git://host.containers.internal:9418/solrise_erp
SOLRISE_APP_BRANCH=main
# Optional: force a rebuild of the app layer by bumping this. Leave
# empty normally - the build fingerprints the app branch's remote commit.
SOLRISE_APP_REV=

# --- 5. Site -----------------------------------------------------------------
# Local: erp.localhost (resolves to 127.0.0.1 on most systems)
# Prod:  must equal DOMAIN, e.g. erp.yourdomain.com
SITE_NAME=erp.localhost
ADMIN_PASSWORD=change-me-admin
# Comma-separated (no spaces - a shell-sourced .env cannot hold bare spaces).
# The create-site service installs each one, in order.
INSTALL_APPS=erpnext,hrms,solrise_erp

# --- 6. Database -------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-db

# --- 7. Domain & TLS (production only) ---------------------------------------
DOMAIN=erp.example.com
LETSENCRYPT_EMAIL=admin@example.com

# --- 8. Published ports ------------------------------------------------------
# Local: browse http://localhost:8080
# Prod:  use 80/443 so Let's Encrypt HTTP-01 validation can reach Traefik.
# If the port is already taken on your machine (check with `ss -ltn`), pick
# another free one here - only .env changes, not the compose files.
HTTP_PORT=8080
HTTPS_PORT=8443
SOCKETIO_PORT=9000

# --- 9. Named volumes (data survives container recreation) -------------------
SITES_VOLUME=solrise_sites
DB_VOLUME=solrise_db_data
REDIS_QUEUE_VOLUME=solrise_redis_queue
LETSENCRYPT_VOLUME=solrise_letsencrypt

# --- 10. Runtime tuning ------------------------------------------------------
ENABLE_SCHEDULER=true
WORKER_CONCURRENCY=2
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
# Backend gunicorn sizing. (2 x vCPU) + 1 is a reasonable worker count.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- 11. Backups -------------------------------------------------------------
# Host directory scripts/backup.sh copies dumps into.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
