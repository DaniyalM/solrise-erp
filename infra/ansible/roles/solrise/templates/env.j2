# {{ ansible_managed }}
# Rendered by Ansible from group_vars (Terraform facts + Vault). Do not edit on
# the host: change infra/ansible and re-run the playbook.

COMPOSE_PROJECT_NAME=solrise

# --- engine ------------------------------------------------------------------
CONTAINER_ENGINE=podman
COMPOSE_CMD=podman-compose
DOCKER_SOCK=/run/user/{{ deploy_uid }}/podman/podman.sock

# --- image -------------------------------------------------------------------
CUSTOM_IMAGE={{ effective_image }}
CUSTOM_TAG={{ custom_tag }}
PULL_POLICY={{ effective_pull_policy }}
FRAPPE_PATH=https://github.com/frappe/frappe
FRAPPE_BRANCH={{ frappe_branch }}
FRAPPE_IMAGE_PREFIX=docker.io/frappe
FRAPPE_DOCKER_DIR=./frappe_docker
SOLRISE_APP_URL={{ solrise_app_url }}
SOLRISE_APP_BRANCH={{ solrise_app_branch }}

# --- database: Amazon RDS (no local mariadb container) -----------------------
DB_HOST={{ rds_host }}
DB_PORT={{ rds_port }}
DB_ROOT_USERNAME={{ db_root_username_effective }}
DB_ROOT_PASSWORD={{ db_root_password }}

# --- site + TLS --------------------------------------------------------------
SITE_NAME={{ site_name }}
ADMIN_PASSWORD={{ admin_password }}
DOMAIN={{ domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}
HTTP_PORT=80
HTTPS_PORT=443
# Left empty: Traefik's default main-resolver issues the real certificate.
TLS_CERT_RESOLVER=

# --- runtime -----------------------------------------------------------------
GUNICORN_WORKERS={{ gunicorn_workers }}
GUNICORN_THREADS={{ gunicorn_threads }}
GUNICORN_TIMEOUT={{ gunicorn_timeout }}
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
SOCKETIO_PORT=9000
INSTALL_APPS={{ install_apps }}

# --- volumes -----------------------------------------------------------------
SITES_VOLUME=solrise_sites
REDIS_QUEUE_VOLUME=solrise_redis_queue
LETSENCRYPT_VOLUME=solrise_letsencrypt

# --- backups -----------------------------------------------------------------
BACKUP_DIR={{ effective_backup_dir }}
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
